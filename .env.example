# Local synthetic demo; no API credentials required. Never commit a real .env.
OPSPILOT_MODE=demo
POSTGRES_PASSWORD=local-demo-only-change-me
OPSPILOT_DATABASE_URL=postgresql+psycopg://opspilot:local-demo-only-change-me@localhost:5432/opspilot
OPENAI_API_KEY=
OPSPILOT_LLM_MODEL=gpt-4.1-mini
OPSPILOT_EMBEDDING_MODEL=text-embedding-3-small
OPSPILOT_EMBEDDING_DIMENSIONS=512
OPSPILOT_RETRIEVAL_MODE=hybrid
OPSPILOT_TOP_K=5
OPSPILOT_MAX_MODEL_CALLS=8
OPSPILOT_MAX_TOOL_CALLS=12
OPSPILOT_MAX_REVISIONS=1
OPSPILOT_DEADLINE_SECONDS=90
OPSPILOT_PROVIDER_TIMEOUT_SECONDS=25
OPSPILOT_TOOL_TIMEOUT_SECONDS=15
OPSPILOT_CONTEXT_CHARS=24000
OPSPILOT_LOG_LEVEL=INFO
OPSPILOT_DATA_DIR=data/sample
